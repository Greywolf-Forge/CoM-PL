          "selector": "canApplyGunsButterDone2",
          "excerpt": "def canApplyGunsButterDone2(argsList):\n\tiEvent = argsList[0]\n\tkTriggeredData = argsList[1]\n\tplayer = gc.getPlayer(kTriggeredData.ePlayer)\n\n\tiCivic = gc.getInfoTypeForString(\"CIVIC_ARISTOCRACY\")\n\n\tif not player.isCivic(iCivic):\n\t\treturn False\n\n\treturn True"
        },
        {
          "path": "Assets/XML/GameInfo/CIV4CivicInfos.xml",
          "sha256": "cefdc5571cec8e1c0242e5923e188b36d384382a5272704a6dbd9dbaff6c9b16",
          "selector": "CIVIC_ARISTOCRACY/Description",
          "excerpt": "TXT_KEY_CIVIC_ARISTOCRACY"
        },
        {
          "path": "Assets/XML/Text/CIVICS.xml",
          "sha256": "32d8080295f9544c721e966f6f4e3cf7c03600c7827d4a53fe0f26cf3e640496",
          "selector": "TXT_KEY_CIVIC_ARISTOCRACY/English",
          "excerpt": "Nobility"
        }
      ],
      "compatibility": "Applies to this installed mod version; do not replace base BtS civic names globally. Text only; no game data changes.",
      "old": "[COLOR_HIGHLIGHT_TEXT]Vassalage[COLOR_REVERT]",
      "new": "[COLOR_HIGHLIGHT_TEXT]Nobility[COLOR_REVERT]",
