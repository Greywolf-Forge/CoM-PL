          "selector": "create",
          "excerpt": "self.addTextEdit(screen, columnL, columnR, \"UnitNaming__Combat_TRADE\")"
        }
      ],
      "compatibility": "Applies to this installed mod version; do not replace base BtS civic names globally. Text only; no game data changes.",
      "old": "'EXECUTIVES'",
      "new": "'TRADE'",
