    {
      "id": "hostile-takeover-name",
      "source_file": "EVENTS.xml",
      "tag": "TXT_KEY_EVENTTRIGGER_HOSTILE_TAKEOVER_DONE",
      "occurrence": 0,
      "category": "FACTUAL_ERROR",
      "rationale": "EVENTTRIGGER_HOSTILE_TAKEOVER_DONE uses this world-news text after the Hostile Takeover quest. Corporate Expansion is a different quest. Parameters and the rest of the completion message are preserved.",
      "evidence": [
        {
          "path": "Assets/XML/Events/CIV4EventTriggerInfos.xml",
          "sha256": "7d3a8efaa6115f418a0b15ac203c04c0e86843fd3a5101413b92299dc74f0f26",
          "selector": "EVENTTRIGGER_HOSTILE_TAKEOVER_DONE/WorldNewsTexts",
          "excerpt": "TXT_KEY_EVENTTRIGGER_HOSTILE_TAKEOVER_DONE"
        },
        {
          "path": "Assets/Python/EntryPoints/CvRandomEventInterface.py",
          "sha256": "383299af2aaf83fdfdd18a14c2dc44a3a67b93e6d15a16b8bc52e41b9b75b8a3",
          "selector": "canTriggerHostileTakeoverDone",
          "excerpt": "def canTriggerHostileTakeoverDone(argsList):\n\tkTriggeredData = argsList[0]\n\tplayer = gc.getPlayer(kTriggeredData.ePlayer)\n\ttrigger = gc.getEventTriggerInfo(kTriggeredData.eTrigger)\n\tkOrigTriggeredData = player.getEventOccured(trigger.getPrereqEvent(0))\n\n\tlistResources = getHostileTakeoverListResources(gc.getCorporationInfo(kOrigTriggeredData.eCorporation), player)\n\n\tif len(listResources) > 0:\n\t\treturn False\n\n\tkActualTriggeredDataObject = player.getEventTriggered(kTriggeredData.iId)\n\tkActualTriggeredDataObject.eCorporation = kOrigTriggeredData.eCorporation\n\tkActualTriggeredDataObject.eBuilding = kOrigTriggeredData.eBuilding\n\tkActualTriggeredDataObject.iCityId = kOrigTriggeredData.iCityId\n\tkActualTriggeredDataObject.iPlotX = kOrigTriggeredData.iPlotX\n\tkActualTriggeredDataObject.iPlotY = kOrigTriggeredData.iPlotY\n\n\treturn True"
        }
      ],
      "compatibility": "Applies to this installed mod version; do not replace base BtS civic names globally. Text only; no game data changes.",
      "old": "quest of Corporate Expansion",
      "new": "quest of Hostile Takeover",
      "source_sha256": "12ddd4632954d13a2adb9fdc91c5c0d45ff8b030d445c6c8b16741bc053d16b4",
      "reviewer": "Astra /root; independent source and SHA review"
    },
    {
