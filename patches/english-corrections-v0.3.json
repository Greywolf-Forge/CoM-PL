          "path": "Assets/Config/Unit Naming.xml",
          "sha256": "837731e20c9098d220d7d5b39b73b9307399ee63c4f6fd0d69adaf56952c2939",
          "selector": "option[@id=\"Combat_TRADE\"] and option[@id=\"Combat_EXECUTIVES\"]"
